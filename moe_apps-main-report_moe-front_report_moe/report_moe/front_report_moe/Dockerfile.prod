# Production image for front_report_moe: build the Angular app, serve the
# static output through nginx (no Node process at runtime).
#
#   docker build -f report_moe/front_report_moe/Dockerfile.prod -t report-front:prod report_moe/front_report_moe

FROM node:22-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# angular.json's default build configuration is already "production", which is
# what makes environment.prod.ts (apiUrl: '/api/v1') get used via fileReplacements.
RUN npx ng build

FROM nginx:1.27-alpine
COPY --from=build /app/dist/front_report_moe/browser /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
