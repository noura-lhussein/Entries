# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# Variables already set in the shell or Docker Compose take precedence over .env.

# ── Django core ──────────────────────────────────────────────────────────────
# Required in production — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-long-random-string


# 1 = development (default), 0 = production
DEBUG=1

# Comma-separated hostnames (use * only in local DEBUG mode)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Leave DB_HOST empty to use SQLite (db.sqlite3). Set DB_HOST to enable PostgreSQL.
# Shared DB with moeds: schemas report_moe + common (auth) + public (PostGIS).
# Use the `report_app` runtime role, not postgres: it is the single writer for the
# master/catalog tables in schema `moeds` and read-only on moeds operational tables.
# Create it with deploy/db/enforce_single_writer.sql.
# `manage.py migrate` needs DDL — run it as postgres, not as this role.
DB_HOST=localhost
DB_NAME=moe_shared
DB_USER=report_app
DB_PASSWORD=change-me
DB_PORT=5432
DB_SEARCH_PATH=report_moe,public

# Docker Compose example (uncomment when using docker-compose.yml):
# DB_HOST=db
# DB_NAME=moe_shared
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_PORT=5432
# DB_SEARCH_PATH=report_moe,public

# ── GeoDjango / locations CSV import ─────────────────────────────────────────
# PostgreSQL with PostGIS is required when DB_HOST is set (GeoDjango backend).
# Path to aqiel CSV files (governorates/districts/subdistricts):
# LOCATIONS_DATA_DIR=C:\Users\abdel\OneDrive\المستندات\MOE\MOE_report_v1\docs\locations
# Windows — auto-detected from QGIS/OSGeo4W when installed; override if needed:
# QGIS_ROOT=C:\Program Files\QGIS 4.0.1
# GDAL_LIBRARY_PATH=C:\Program Files\QGIS 4.0.1\bin\gdal312.dll
# GEOS_LIBRARY_PATH=C:\Program Files\QGIS 4.0.1\bin\geos_c.dll
# PROJ_LIB=C:\Program Files\QGIS 4.0.1\share\proj

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
# Dev: the Angular dev servers (portal :4202, report front :4201) proxy /api to
# this backend, so requests are same-origin and CORS is not exercised. These
# lists only matter if a browser client talks to the API cross-origin.
# Production (single-origin behind one nginx): leave CORS_ALLOWED_ORIGINS empty
# and set CSRF_TRUSTED_ORIGINS to the site's https:// origin — the scheme is
# mandatory (Django 4+), e.g. https://portal.moenergy.gov.sy
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://localhost:4202,http://127.0.0.1:4202
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201,http://localhost:4202,http://127.0.0.1:4202

# ── Session / CSRF cookie security ────────────────────────────────────────────
# Default: 0 in DEBUG, 1 otherwise. Set to 1 only when the site is served over
# HTTPS (nginx TLS). SECURE_PROXY_SSL_HEADER is always on so Django trusts
# nginx's X-Forwarded-Proto.
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# Optional extra production hardening (opt-in):
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_AGE=1209600

# ── File uploads (Info image/file fields) ──────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2
# Or exact bytes: MAX_UPLOAD_SIZE_BYTES=2097152


GDAL_DATA=C:\Program Files\GDAL\gdal-data
